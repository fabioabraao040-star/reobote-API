# ==============================================================================
# REOBOTE API - VARIÁVEIS DE AMBIENTE (.env)
# ==============================================================================
# ATENÇÃO: NUNCA commite chaves ou certificados reais no repositório Git!
# Copie este arquivo para .env e preencha com seus dados locais ou configure no Vercel.

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES GERAIS DA API
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN=*

# Chave secreta de autenticação entre o Base44 e esta REOBOTE API.
# O Base44 deve enviar esta chave no cabeçalho 'x-api-key' ou 'Authorization: Bearer <token>'
REOBOTE_API_KEY="sua_chave_secreta_reobote_base44"

# Rate Limit (proteção contra abuso)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DA EFÍ (GERENCIANET) - PIX
# ------------------------------------------------------------------------------
# Ambiente: 'homologacao' para testes sandbox ou 'producao' para cobranças reais
EFI_ENVIRONMENT=homologacao

# Chave PIX cadastrada na conta Efí (CPF, CNPJ, E-mail, Telefone ou Chave Aleatória EVP)
EFI_PIX_KEY="sua_chave_pix_cadastrada_na_efi"

# Credenciais da aplicação criada no painel da Efí (API Pix)
EFI_CLIENT_ID="Client_Id_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
EFI_CLIENT_SECRET="Client_Secret_YYYYYYYYYYYYYYYYYYYYYYYYYY"

# Certificado da Efí (.p12 ou .pem)
# No Vercel (Recomendado): Converta o arquivo .p12 para Base64 em uma única linha:
#   Linux/Mac: base64 -w 0 certificado.p12
#   Windows: certutil -encode certificado.p12 cert.txt (remova as quebras de linha)
# Cole a string resultante aqui:
EFI_CERTIFICATE="MIIG+AIBAzCCBqMGCSqGSIb3DQEHAaCCBpQEggaQ..."

# Senha do certificado (.p12) caso tenha sido definida ao gerar na Efí
EFI_CERTIFICATE_PASSWORD=""

# Opcional: Se usar certificado PEM separado com chave privada
EFI_PRIVATE_KEY=""

# Segredo compartilhado opcional para validar webhooks recebidos da Efí
EFI_WEBHOOK_SECRET="seu_segredo_webhook_efi_opcional"

# Timeout em milissegundos para chamadas à Efí
EFI_TIMEOUT_MS=12000

# Modo de simulação para desenvolvimento local caso ainda não tenha credenciais Efí (true/false)
EFI_SIMULATION_MODE=false

# ------------------------------------------------------------------------------
# CONFIGURAÇÕES DE INTEGRAÇÃO COM O BASE44
# ------------------------------------------------------------------------------
# URL base da API do sistema Base44 REOBOTE
# Exemplo: https://sua-empresa.base44.app/api ou http://localhost:8000/api
BASE44_API_URL="https://sua-api.base44.app/api"

# Chave de autenticação fornecida pelo Base44 (Token API)
BASE44_API_KEY="seu_token_api_base44"

# Segredo para assinatura HMAC do webhook enviado ao Base44 (header x-webhook-signature)
BASE44_WEBHOOK_SECRET="seu_segredo_webhook_base44"

# Endpoint no Base44 que recebe a confirmação e atualização de status de pagamento
BASE44_PAYMENT_UPDATE_ENDPOINT="/pagamentos/webhook"

# Timeout em milissegundos para chamadas ao Base44
BASE44_TIMEOUT_MS=10000
